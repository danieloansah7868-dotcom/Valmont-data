# ============================================================================
# Valmont Data starter (Next.js + Postgres + Paystack) — environment
# Copy to .env.local:  cp .env.example .env.local
# ⚠️  This starter is SUPERSEDED by the production app in ../app — reference only.
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (Supabase / Neon / local). Use the pooled URI
# (port 6543 with Supabase) for serverless.
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
DATABASE_SSL=true
# Zero-config local dev instead: in-memory Postgres (schema.sql auto-applied),
# no DATABASE_URL needed. Shortcut: npm run dev:mem
# MEMORY_DB=1

# ── Auth ────────────────────────────────────────────────────────────────────
# Long random string — signs the httpOnly JWT session cookie.
AUTH_SECRET=change-me-to-a-long-random-string

# ── Paystack (MoMo charges + webhooks) ──────────────────────────────────────
# Optional: without it the app runs in DEV MODE — MoMo charges/deposits
# auto-approve locally. Webhook: https://your-domain/api/webhooks/paystack
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# ── Supplier / wholesale provider ───────────────────────────────────────────
PROVIDER_DRIVER=mock                   # mock | remadata
# RemaData (https://remadata.com):
# REMADATA_API_KEY=
# Plan map, network → GB → plan_id (see scripts/sync-prices.js):
# REMADATA_PLANS={"mtn":{"1":1001,"2":1002,"10":1003},"telecel":{"10":2001},"airteltigo":{"1":3001}}

# ── Mock provider tuning ────────────────────────────────────────────────────
MOCK_DELIVER_MS=20000                  # mock delivery latency (README: ~20s)
MOCK_FAIL_RATE=0                       # 0..1 — e.g. "0.2" to see auto-refunds
