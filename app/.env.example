# ============================================================================
# Valmont Data — environment variables
# Copy to .env.local for local use:  cp .env.example .env.local
# On Vercel: Project Settings → Environment Variables (set each of these).
#
# The local dev server (scripts/dev-server.js) ships safe dev defaults and
# does not read this file — you only need real values for deployment, or to
# override defaults inline, e.g.  MOCK_FAIL_FIRST=1 npm run dev
# ============================================================================

# ── Supabase (required in production) ───────────────────────────────────────
# Project Settings → API. SERVICE-ROLE key — server-side only, never client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Force the in-memory DB instead (local dev / CI only — NEVER in production):
# SUPABASE_MOCK=1

# ── Valmont-Pay, tenant #3 (required in production) ─────────────────────────
# Live gateway configuration (Valmont-Pay gateway: tenant valmontdata).
# Initializes checkout via POST /api/transaction/initialize with Bearer auth,
# and verifies payment webhooks via charge.success signed with HMAC-SHA512
# in the x-valmontpay-signature header.
VALMONTPAY_API_URL=https://valmontpay.app/api
VALMONTPAY_API_KEY=sk_valmontdata_xxxxxxxxxxxxxxxx
VALMONTPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# Payment mode. LIVE is the production setting: no simulated payments, ever —
# a missing key/secret fails loudly (503) instead of faking a checkout or
# auto-reload charge. dev (local only, set by scripts/dev-server.js) allows
# simulating payments with scripts/sim-webhook.js.
VALMONTPAY_MODE=live

# ── Site + privileged jobs ───────────────────────────────────────────────────
SITE_URL=http://localhost:8787          # REQUIRED: https://your-domain in production
ADMIN_PASSWORD=admin123                  # use a unique strong password in production
ADMIN_ACTOR=administrator                # optional non-secret audit label for admin actions
AUTH_SECRET=dev-secret-change-me         # REQUIRED: unique random 16+ character token-signing secret in production
# REQUIRED for deployed Vercel cron calls. Vercel sends: Authorization: Bearer <secret>.
# Generate 32+ random characters; never use dev-cron-secret or changeme.
CRON_SECRET=
PORT=8787                                # dev server only

# ── Float guard / alerts ────────────────────────────────────────────────────
LOW_FLOAT_THRESHOLD=50                   # GHS per network; cron alerts below this
# Optional: POST endpoint for receipts + low-float + failure alerts
# (WhatsApp/SMS gateway, Valmont Web Services flow, Slack…). Receives JSON.
# NOTIFY_WEBHOOK_URL=

# ── Auto-reload (usage tracking + automatic top-ups) ────────────────────────
# Shared key the supplier/telco usage feed uses to POST usage reports
# (POST /api/usage). Admin tokens also work. Dev default: dev-usage-key.
# REQUIRED in production: unique random 16+ characters (the dev default is rejected).
USAGE_REPORT_KEY=
# Minutes between automatic reloads of the same line (default 720 = 12h).
# AUTORELOAD_COOLDOWN_MINUTES=720
# NEVER set this in production. 1 = dev servers may simulate the auto-reload
# charge webhook locally (scripts/dev-server.js defaults to 1). Live mode
# never simulates: reloads charge the pre-authorized MoMo via
# POST /api/transaction/charge (method momo, type direct).
# AUTORELOAD_SIMULATE=1

# ── Suppliers (wholesale data + automatic failover) ─────────────────────────
# Comma-separated priority order. The router moves to the next supplier ONLY
# after a definitive rejection. Timeouts/pending replies pause for confirmation
# to prevent delivering the same bundle twice.
SUPPLIER_ORDER=mock                      # LOCAL ONLY — deployment rejects mock; use typhonic,remadata with real credentials
# Optional network-specific priorities and emergency kill switch:
# SUPPLIER_ORDER_MTN=typhonic,remadata
# SUPPLIER_ORDER_TELECEL=typhonic,remadata
# SUPPLIER_ORDER_AIRTELTIGO=typhonic,remadata
# SUPPLIER_DISABLED=                      # e.g. remadata during maintenance
SUPPLIER_CIRCUIT_FAILURES=3              # temporarily pause after N failures
SUPPLIER_CIRCUIT_COOLDOWN_MS=300000      # retry an unhealthy supplier after 5m
SUPPLIER_TIMEOUT_MS=15000

# Legacy single-driver setting (used only when SUPPLIER_ORDER is unset):
# SUPPLIER_DRIVER=remadata

# RemaData:
REMADATA_API_URL=https://remadata.com/api
REMADATA_API_KEY=

# Typhonic agent API. Get the exact paths/field names from the approved agent
# documentation; the driver intentionally stays disabled until PURCHASE_PATH
# is set, because guessing a money-moving endpoint is unsafe.
TYPHONIC_API_URL=
TYPHONIC_API_KEY=
TYPHONIC_PURCHASE_PATH=
TYPHONIC_STATUS_PATH=                    # e.g. /orders/{reference}
TYPHONIC_BUNDLES_PATH=
TYPHONIC_BALANCE_PATH=
TYPHONIC_AUTH_HEADER=Authorization
TYPHONIC_AUTH_SCHEME=Bearer
TYPHONIC_REFERENCE_FIELD=reference
TYPHONIC_PHONE_FIELD=phone
TYPHONIC_NETWORK_FIELD=network
TYPHONIC_VOLUME_FIELD=volumeInMB

# ── Mock supplier tuning (dev only) ─────────────────────────────────────────
MOCK_DELIVER_MS=1200                     # simulated delivery latency
MOCK_FAIL_RATE=0                         # 0..1 random failure probability
MOCK_FAIL_FIRST=0                        # 1 = first attempt of every order fails (retry path)

# ── WhatsApp ordering bot ────────────────────────────────────────────────────
# WhatsApp Cloud API (Meta) — order data bundles by chatting on WhatsApp.
# 1. Create a WhatsApp Business app at developers.facebook.com
# 2. Get a permanent System User token (never expires)
# 3. Set the webhook URL to https://<your-domain>/api/whatsapp/webhook
# 4. Set the verify token to whatever string you choose (must match both sides)
WHATSAPP_MODE=mock                       # LOCAL ONLY — deployment requires live (and rejects mock)
WHATSAPP_TOKEN=                          # Meta System User access token
WHATSAPP_PHONE_ID=                       # WhatsApp phone number ID
WHATSAPP_VERIFY_TOKEN=valmont-data-verify  # production: unique random 16+ character verification string

# ── SMS notifications ────────────────────────────────────────────────────────
# Send transactional SMS (delivery confirmations, refund notices) to customers.
# Providers: arkesel | mnotify | hubtel | mock
# mock is LOCAL ONLY — deployed endpoints refuse mock/unconfigured SMS success.
SMS_PROVIDER=mock
SMS_API_KEY=                             # required by a live provider
SMS_SENDER_ID=ValmontData                # sender name (max 11 chars)

# ── Referral program ────────────────────────────────────────────────────────
# Customers earn credit when their friends make their first purchase.
REFERRAL_CREDIT_AMOUNT=2.00              # GHS credit per successful referral
REFERRAL_MAX_CREDIT=50.00                # max GHS credit a customer can hold

# ── Reseller program ────────────────────────────────────────────────────────
# Customers open stores at /store.html, set a markup %, and earn margin on
# every order placed through their store link (/s/{slug}).
# No additional config needed — works out of the box with the existing
# order pipeline. Earnings tracked in reseller_earnings ledger.


# ── Review invitations and truthful refunds ──────────────────────────────────
# Delivered account orders may include a direct /rev/... link with no incentive:
# SMS only if account buyer phone == recipient; WhatsApp only if the originating
# WhatsApp sender matches that account phone. SMS links are sent only where the
# complete plain-text receipt is one GSM-7 segment.
#
# Valmont-Pay has no automated refund API in this app. Live delivery/payment
# failures become refund_pending; an authenticated admin must complete the real
# gateway action, then use Orders → "Mark gateway refund completed" to record it.
