{
  "crons": [
    {
      "path": "/api/cron/retry",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/autoreload",
      "schedule": "30 7 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/api/account/:path*", "destination": "/api/account" },
    { "source": "/api/auth/customer/:path*", "destination": "/api/auth/customer" },
    { "source": "/api/whatsapp/:path*", "destination": "/api/whatsapp/webhook" },
    { "source": "/api/referrals/:path*", "destination": "/api/referrals" },
    { "source": "/api/store/:path*", "destination": "/api/store" },
    { "source": "/s/:slug", "destination": "/storefront.html" },
    { "source": "/r/:code", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
