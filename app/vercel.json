{
  "crons": [
    {
      "path": "/api/cron/retry",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/autoreload",
      "schedule": "30 7 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/api/account/:path*", "destination": "/api/account" },
    { "source": "/api/auth/customer/:path*", "destination": "/api/auth/customer" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
